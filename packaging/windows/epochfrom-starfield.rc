// Windows resource script for EpochFrom-starfield.exe -- see
// epochfrom-gui.rc for what this is for and why it's separate from
// AppIcon.h/resources/icon.qrc.
IDI_ICON1 ICON "epochfrom.ico"

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "EpochFrom"
            VALUE "FileDescription", "EpochFrom Starfield -- standalone Gaia DR3 proper-motion viewer"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "EpochFrom-starfield"
            VALUE "OriginalFilename", "EpochFrom-starfield.exe"
            VALUE "ProductName", "EpochFrom"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
