// Windows resource script for EpochFrom-gui.exe.
//
// This is a different, unrelated icon mechanism from
// AppIcon.h/resources/icon.qrc: that one gives the *running window* its
// icon via QApplication::setWindowIcon(), which works correctly the
// moment the app launches, on every platform, with no install step (see
// AppIcon.h's own comment). What only a compiled-in Windows resource like
// this one can do is give the .exe *file itself* an icon -- what File
// Explorer, a taskbar pin created before the app has ever run, and a
// desktop shortcut all show. IDI_ICON1 is an arbitrary resource ID; what
// matters to Windows is that it's the *first* icon resource in the .exe,
// since that's the one Explorer uses for the file itself.
IDI_ICON1 ICON "epochfrom.ico"

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "EpochFrom"
            VALUE "FileDescription", "EpochFrom -- date astrophotography images from Gaia DR3 proper motions"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "EpochFrom-gui"
            VALUE "OriginalFilename", "EpochFrom-gui.exe"
            VALUE "ProductName", "EpochFrom"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
